# Copy this file to fastlane/.env (gitignored) and fill it in from
# App Store Connect → Users and Access → Integrations → App Store Connect API.
# The key must be a Team key of team 3VN358756R whose role can register App IDs,
# manage provisioning profiles and notarize (Admin covers all three); a key whose
# role is too low fails a few minutes into the run with Apple's bare 403.
# fastlane's own names work too: APP_STORE_CONNECT_API_KEY_KEY_ID,
# APP_STORE_CONNECT_API_KEY_ISSUER_ID and APP_STORE_CONNECT_API_KEY_KEY_FILEPATH.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# A relative path is looked up under fastlane/ first, then under the repository
# root; an absolute path is used as it is.
ASC_KEY_FILEPATH=AuthKey_XXXXXXXXXX.p8
