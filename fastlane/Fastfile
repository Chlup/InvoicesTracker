# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "securerandom"
require "shellwords"
require "tmpdir"

# require_relative rather than fastlane's intercepted `require`, so the local
# files raise no "you have required a gem" notice. The lib directory is on the
# load path as well, so the helpers can also require each other by name.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require_relative "lib/invoices_tracker/api_key_settings"
require_relative "lib/invoices_tracker/release"
require_relative "lib/invoices_tracker/paths"
require_relative "lib/invoices_tracker/dmg"
require_relative "lib/invoices_tracker/dmg_tool"
require_relative "lib/invoices_tracker/signing_identity"
require_relative "lib/invoices_tracker/build_settings"
require_relative "lib/invoices_tracker/verification"
require_relative "lib/invoices_tracker/working_copy"
require_relative "lib/invoices_tracker/preflight"
require_relative "lib/invoices_tracker/ci_build"
require_relative "lib/invoices_tracker/ci_keychain"
require_relative "lib/invoices_tracker/deploy_preflight"
require_relative "lib/invoices_tracker/github_releases"
require_relative "lib/invoices_tracker/log_text"
require_relative "lib/invoices_tracker/release_manifest"
require_relative "lib/invoices_tracker/release_naming"
require_relative "lib/invoices_tracker/release_notes"
require_relative "lib/invoices_tracker/sparkle"

# fastlane/README.md is written by hand; fastlane must not regenerate it.
skip_docs

# Gemfile.lock pins fastlane. Outside Bundler, whatever fastlane happens to be
# installed would run the lane.
UI.user_error!("Run through Bundler: bundle exec fastlane dmg, or ./Scripts/release.sh") unless ENV["BUNDLE_GEMFILE"]

# fastlane evaluates this file under a relative name, so __dir__ is "." and
# means the fastlane directory only while that is the working directory, as it
# is while the file loads. Both directories are made absolute now: actions run
# from the repository root, where a relative path would point elsewhere.
FASTLANE_DIR = File.expand_path(__dir__)
REPO_ROOT = File.expand_path("..", __dir__)

# The app target. Its version and build number name the release.
APP_TARGET = "InvoicesTracker"
CONFIGURATION = "Release"

# xcbeautify, not xcpretty: xcpretty swallows the output of Swift Testing, so a
# failing test would scroll past without a word.
XCODEBUILD_FORMATTER = "xcbeautify"

# python3 makes the virtual environment that holds dmgbuild, the tool that makes
# the DMG.
REQUIRED_TOOLS = %w[python3 xcbeautify].freeze

# What dmgbuild is installed from, and the layout it gives the disk image.
DMG_REQUIREMENTS = File.join(FASTLANE_DIR, "requirements-dmg.txt")
DMG_SETTINGS = File.join(FASTLANE_DIR, "dmg_settings.py")

# What sparkle_feed leaves for the publish job: the DMG, the appcast, the notes
# and release.json. The appcast is made in the staging folder, which holds only
# the DMG and its notes, since generate_appcast reads every archive it finds.
FEED_DIR = File.join(REPO_ROOT, "build", "feed")
FEED_STAGING_DIR = File.join(REPO_ROOT, "build", "feed-staging")

desc "Builds the signed, notarized DMG of the checked-out commit: build/InvoicesTracker-<version>-<build>.dmg."
desc "The version and build number come from the Xcode project. skip_tests:true skips the unit tests."
lane :dmg do |options|
  skip_tests = [true, "true"].include?(options[:skip_tests])

  # Nothing here contacts Apple, and every problem shows at once, before the
  # tests or the build start.
  versions, identity, key_settings, working_copy =
    preflight.values_at(:versions, :identity, :key_settings, :working_copy)
  paths = announce_build(versions: versions, identity: identity, working_copy: working_copy)

  # The first run, and a run after the requirements changed, install dmgbuild
  # from PyPI. That comes right after the preflight, so that a failure costs
  # seconds and not the whole build.
  dmgbuild = ensure_dmgbuild
  clear_previous_build(paths)

  if skip_tests
    UI.important("Skipping the unit tests (skip_tests:true)")
  else
    unit_tests(paths, xcargs: "-skipMacroValidation")
  end

  api_key = register_app_and_profile(key_settings, paths)
  archive_and_export(paths: paths, identity: identity, xcargs: local_archive_xcargs(key_settings))

  # The preflight's look at the working copy was minutes ago, before the tests
  # and the archive. A branch switch, a stash pop or an editor's autosave since
  # then is compiled into the app, and the DMG would pass every check below
  # while matching no commit. No DMG exists yet, so there is nothing to clean up.
  ensure_working_copy_unchanged(since: working_copy)

  notarized_dmg(paths: paths, identity: identity, api_key: api_key, dmgbuild: dmgbuild)
  UI.success("DMG ready: #{paths[:final_dmg]} (#{working_copy.short_head})")
end

desc "CI only (CI=true, RUNNER_TEMP): the dmg lane on a GitHub-hosted runner, for the release workflow."
desc "version: and build: are the typed numbers and must be the branch's. deploy:true also checks what a release " \
     "needs (changelog, tag, Latest release, the app's update settings). skip_tests:true skips the unit tests."
desc "Signs from a temporary keychain made from DEVELOPER_ID_P12 and DEVELOPER_ID_P12_PASSWORD, removed at the end."
lane :ci_dmg do |options|
  ci = ci_options(options)
  # The secrets leave the environment before the lane starts any tool, so that
  # no tool, build script or test inherits them; the lane hands them on itself.
  identity_file = rewrapped_developer_id
  sparkle_key = ENV.delete("SPARKLE_PRIVATE_KEY")
  keychain = InvoicesTracker::CiBuild.keychain_path(ci[:runner_temp])
  # Read before anything changes, so that it can be put back.
  search_list = keychain_search_list

  # From the first keychain command on, the keychain is removed and the search
  # list put back however the build ends.
  begin
    make_signing_keychain(keychain: keychain, search_list: search_list, identity_file: identity_file,
                          runner_temp: ci[:runner_temp])
    build_on_ci(ci, keychain: keychain, sparkle_key: sparkle_key)
  ensure
    remove_signing_keychain(keychain: keychain, search_list: search_list)
  end
end

desc "Writes build/feed/ for publishing the DMG that ci_dmg made: the DMG, its signed Sparkle appcast.xml, " \
     "release-notes.md and release.json."
desc "version: and build: name the DMG. RELEASE_CHANGELOG holds the notes, SPARKLE_PRIVATE_KEY signs the feed, " \
     "and gh asks GitHub about the tag and the Latest release."
lane :sparkle_feed do |options|
  # The key leaves the environment before the lane starts any tool, and reaches
  # generate_appcast on standard input alone.
  sparkle_key = ENV.delete("SPARKLE_PRIVATE_KEY")
  # A run that stops on the way leaves no feed behind that could be taken for its result.
  FileUtils.rm_rf(FEED_DIR)

  version = options[:version].to_s.strip
  build = options[:build].to_s.strip
  format_errors = InvoicesTracker::BuildSettings.typed_format_errors(version: version, build: build)
  UI.user_error!("The feed cannot be made:\n#{bullet_list(format_errors)}") unless format_errors.empty?

  paths = InvoicesTracker::Paths.resolve(repo_root: REPO_ROOT, version: version, build: build)
  dmg = paths[:final_dmg]
  UI.user_error!("There is no DMG at #{dmg} — the ci_dmg lane makes it") unless File.file?(dmg)
  tools_dir = InvoicesTracker::Sparkle.tools_dir(derived_data: paths[:derived_data])
  unless File.executable?(File.join(tools_dir, "generate_appcast"))
    UI.user_error!("the branch's app has no Sparkle — no generate_appcast in #{tools_dir}")
  end
  UI.user_error!("gh is not installed — brew install gh") unless installed?("gh")

  # The checks of a deploy once more, on the app inside the DMG this time: its
  # SUFeedURL and SUPublicEDKey, the key, the changelog, the tag and the Latest
  # release, whose tag goes into release.json for the publish job to compare.
  UI.message("Checking the app in #{File.basename(dmg)}, the changelog, the key and GitHub...")
  check = deploy_check(version: version, build: build, gh_installed: true, info_plist: info_plist_in_dmg(dmg),
                       sparkle_key: sparkle_key)
  UI.user_error!("The feed cannot be made:\n#{bullet_list(check[:errors])}") unless check[:errors].empty?

  notes = InvoicesTracker::ReleaseNotes.normalize(ENV["RELEASE_CHANGELOG"])
  appcast = signed_appcast(dmg: dmg, notes: notes, tools_dir: tools_dir, version: version, build: build,
                           sparkle_key: sparkle_key)
  manifest = write_feed(dmg: dmg, appcast: appcast, notes: notes, version: version, build: build,
                        latest: check[:latest_release])
  UI.success("Feed ready: #{FEED_DIR} (#{manifest['tag']}, Latest release seen: " \
             "#{manifest['latest_tag_seen'].empty? ? 'none' : manifest['latest_tag_seen']})")
end

# --- the steps of a release build --------------------------------------------

# The paths of the build of `versions`, after the lane has said what it is
# about to build: the commit, the version and build, the signing identity and
# where the DMG will be.
def announce_build(versions:, identity:, working_copy:)
  paths = InvoicesTracker::Paths.resolve(
    repo_root: REPO_ROOT, version: versions.marketing_version, build: versions.build
  )
  UI.success("Preflight passed")
  UI.message("Building #{working_copy.short_head} …")
  UI.message("Version:  #{versions.marketing_version}")
  UI.message("Build:    #{versions.build}")
  UI.message("Identity: #{identity.name}")
  UI.message("DMG:      #{paths[:final_dmg]}")
  paths
end

# A DMG of the same name is gone as soon as the build starts, so a run that
# fails cannot leave an older DMG behind that looks like its result. The work
# folder starts empty.
def clear_previous_build(paths)
  remove_previous_dmg(paths[:final_dmg])
  FileUtils.rm_rf(paths[:work_dir])
  FileUtils.mkdir_p(paths[:work_dir])
end

# Runs the unit tests in the tests' own DerivedData folder, with `xcargs` (one
# string, split like a shell command line) and, when given, `skip_testing`, the
# tests to leave out as `<target>/<suite>`.
def unit_tests(paths, xcargs:, skip_testing: nil)
  options = {
    project: paths[:project],
    scheme: InvoicesTracker::Release::SCHEME,
    destination: "platform=macOS",
    derived_data_path: paths[:test_derived_data],
    xcodebuild_formatter: XCODEBUILD_FORMATTER,
    xcargs: xcargs,
    output_directory: File.join(REPO_ROOT, "build", "test_output"),
    # The JUnit report only. The default also asks for an HTML report, which
    # only xcpretty can write, so it would only add a warning to every run.
    output_types: "junit"
  }
  options[:skip_testing] = skip_testing if skip_testing
  run_tests(**options)
end

# Loads the App Store Connect API key and makes sure the App ID and the
# Developer ID profile exist; returns the key for the notarization. The App ID
# and the profile come before the build, so a signing or permission problem
# fails within seconds instead of after the archive.
def register_app_and_profile(key_settings, paths)
  api_key = app_store_connect_api_key(
    key_id: key_settings.key_id,
    issuer_id: key_settings.issuer_id,
    key_filepath: key_settings.key_file
  )
  ensure_app_id(api_key)
  ensure_profile(api_key, output_path: paths[:work_dir])
  api_key
end

# Turns the exported app into the finished DMG at the final path: notarizes
# and staples the app, puts a copy of it in a disk image, signs, notarizes and
# staples the image, and verifies the image and the app. Only a DMG that passed
# verification reaches the final path; any failure on the way deletes it.
def notarized_dmg(paths:, identity:, api_key:, dmgbuild:)
  # notarize also staples the ticket to the app.
  UI.message("Notarizing #{File.basename(paths[:app])}...")
  notarize(package: paths[:app], api_key: api_key, print_log: true)

  # The image gets a copy of the notarized app from the staging folder, which
  # holds nothing else. ditto keeps the signature, the stapled ticket and the
  # extended attributes.
  app_bundle = File.basename(paths[:app])
  staged_app = File.join(paths[:staging], app_bundle)
  FileUtils.rm_rf(paths[:staging])
  FileUtils.mkdir_p(paths[:staging])
  run_argv(["ditto", paths[:app], staged_app])

  volicon = volume_icon(paths[:app])
  UI.important("The app has no icon — the DMG gets no volume icon") unless volicon

  # From here on a DMG exists at work_dmg. Any failure deletes it, and only a
  # DMG that passed verification is moved to the final path.
  deleting_on_failure(paths[:work_dmg]) do
    UI.message("Creating the DMG...")
    make_dmg = InvoicesTracker::Dmg.dmgbuild_command(
      dmgbuild: dmgbuild, settings: DMG_SETTINGS, app: staged_app, dmg_path: paths[:work_dmg],
      volname: InvoicesTracker::Release::APP_NAME, volicon: volicon
    )
    # dmgbuild writes the window layout into the image itself and never drives
    # Finder. What can still fail now and then is hdiutil, which it runs to make,
    # mount, detach and compress the image, for instance with "Resource busy"
    # while macOS still holds the volume. dmgbuild retries the detach by itself;
    # this one retry is for the other steps. A failed attempt can leave a partly
    # written image, so that image is deleted before the retry.
    run_argv(make_dmg, retries: 1) { FileUtils.rm_f(paths[:work_dmg]) }

    UI.message("Signing the DMG...")
    run_argv(InvoicesTracker::Dmg.codesign_command(path: paths[:work_dmg], identity: identity.sha1))

    UI.message("Notarizing the DMG...")
    notarize(package: paths[:work_dmg], api_key: api_key, print_log: true)

    UI.message("Verifying the DMG and the app...")
    errors = verification_errors(dmg: paths[:work_dmg], app: paths[:app])
    unless errors.empty?
      FileUtils.rm_f(paths[:work_dmg])
      UI.user_error!("The DMG failed verification and was deleted:\n#{bullet_list(errors)}")
    end

    FileUtils.mv(paths[:work_dmg], paths[:final_dmg])
  end
end

# --- preflight ---------------------------------------------------------------

# Gathers what decides whether the lane may build, and stops the lane with
# every problem at once. Returns the versions, the signing identity, the API key
# settings and the working copy (clean, and the commit the build starts from);
# the settings are read here once, and the later steps use what this returns.
#
# `tools` are the command-line tools the lane needs. A lane with checks of its
# own passes a block: it gets the project's versions (nil when they could not
# be read), the tools that are missing and the app target's INFOPLIST_FILE
# setting (nil when it has none), and returns its problems, which come last.
def preflight(tools: REQUIRED_TOOLS)
  UI.message("Checking the working copy, the tools, the API key, the keychain and the project...")

  working_copy = working_copy_snapshot
  missing_tools = tools.reject { |tool| installed?(tool) }
  # Only whether the key file is there is checked; the key itself is never read here.
  key_settings = InvoicesTracker::ApiKeySettings.resolve(
    ENV, fastlane_dir: FASTLANE_DIR, repo_root: REPO_ROOT, file_exists: File.method(:exist?)
  )
  identity_result = InvoicesTracker::SigningIdentity.developer_id(
    run("security find-identity -v -p codesigning", must_succeed: true),
    team_id: InvoicesTracker::Release::TEAM_ID
  )
  project = project_settings

  report = InvoicesTracker::Preflight.check(
    InvoicesTracker::Preflight::Context.new(
      dirty_paths: working_copy.dirty_paths,
      missing_tools: missing_tools,
      api_key_settings: key_settings,
      identity_result: identity_result,
      version_errors: project[:version_errors]
    )
  )
  errors = report.errors
  if block_given?
    errors += yield(versions: project[:versions], missing_tools: missing_tools,
                    info_plist_file: project[:info_plist_file])
  end
  UI.user_error!("Preflight failed:\n#{bullet_list(errors)}") unless errors.empty?

  { versions: project[:versions], identity: identity_result.identity, key_settings: key_settings,
    working_copy: working_copy }
end

# Whether the command-line tool `tool` is installed, that is, found in PATH.
def installed?(tool)
  !run("command -v #{tool.shellescape}", must_succeed: false).strip.empty?
end

# The working copy as git reports it now: the commit HEAD points at, and the
# paths with uncommitted changes. Untracked files that are not ignored count
# too: the build could compile them into the app. The preflight takes one of
# these and the lane takes another right after the archive; what to make of the
# two is InvoicesTracker::WorkingCopy's decision.
def working_copy_snapshot
  git = "git -C #{REPO_ROOT.shellescape}"
  InvoicesTracker::WorkingCopy.snapshot(
    head_output: run("#{git} rev-parse HEAD", must_succeed: true),
    status_output: run("#{git} status --porcelain --untracked-files=normal", must_succeed: true)
  )
end

# Stops the lane when the working copy is no longer the one `since` saw: HEAD
# moved, or something is uncommitted.
def ensure_working_copy_unchanged(since:)
  error = InvoicesTracker::WorkingCopy.error_since(since, working_copy_snapshot)
  UI.user_error!(error) if error
end

# What the lane needs from the app target's build settings, read with one
# xcodebuild call: `versions`, its version and build number, nil when they
# could not be read; `version_errors`, the problems with them; and
# `info_plist_file`, its INFOPLIST_FILE setting as the project writes it, nil
# when it has none or the settings could not be read.
def project_settings
  json, stderr, status = read_build_settings
  unless status.success?
    message = "cannot read the version from the project: xcodebuild -showBuildSettings failed " \
              "(exit #{status.exitstatus}): #{error_line(stderr)}"
    return { versions: nil, version_errors: [message], info_plist_file: nil }
  end

  versions = InvoicesTracker::BuildSettings.versions(json, target: APP_TARGET)
  { versions: versions, version_errors: InvoicesTracker::BuildSettings.errors(versions),
    info_plist_file: InvoicesTracker::BuildSettings.info_plist_file(json, target: APP_TARGET) }
rescue ArgumentError, JSON::ParserError, KeyError, SystemCallError => e
  { versions: nil, version_errors: ["cannot read the version from the project: #{e.message}"], info_plist_file: nil }
end

# Runs `xcodebuild -showBuildSettings -json` for the scheme's Release
# configuration and returns [stdout, stderr, status]. Only the paths that do
# not depend on the version exist yet.
def read_build_settings
  paths = InvoicesTracker::Paths.base(repo_root: REPO_ROOT)
  argv = [
    "xcodebuild", "-showBuildSettings", "-json",
    "-project", paths[:project],
    "-scheme", InvoicesTracker::Release::SCHEME,
    "-configuration", CONFIGURATION,
    "-derivedDataPath", paths[:derived_data],
    "-skipMacroValidation"
  ]
  # stdout only is read as JSON: xcodebuild prints its warnings on stderr.
  Open3.capture3(*argv)
end

# The property list at `path` as a Hash, converted by plutil, which reads its
# every format. Its text is compared exactly, so it is read as data, never as
# a line of tool output with a line break at its end. Nil when there is no
# path, when the file cannot be read or converted, or when it holds no
# dictionary.
def read_plist(path)
  return nil if path.nil?

  json, _stderr, status = Open3.capture3("plutil", "-convert", "json", "-o", "-", path)
  return nil unless status.success?

  # Read as UTF-8 whatever the locale labels the output with, like the build settings.
  plist = JSON.parse(json.dup.force_encoding(Encoding::UTF_8))
  plist.is_a?(Hash) ? plist : nil
rescue JSON::ParserError, SystemCallError
  nil
end

# --- dmgbuild ----------------------------------------------------------------

# Makes sure the Python environment with dmgbuild exists in build/dmg-env, was
# installed from the current fastlane/requirements-dmg.txt, and returns the path
# of its dmgbuild. An environment that is missing, has no dmgbuild or has a
# stamp that does not match the requirements is deleted and made again with
# pip. The stamp is written last, so an install that fails or is interrupted
# leaves none, and the next run starts over. Only an install needs the network.
def ensure_dmgbuild
  venv_dir = InvoicesTracker::DmgTool.venv_dir(REPO_ROOT)
  dmgbuild = InvoicesTracker::DmgTool.dmgbuild_path(venv_dir)
  stamp_file = InvoicesTracker::DmgTool.stamp_path(venv_dir)
  requirements = File.read(DMG_REQUIREMENTS)
  stamp = File.file?(stamp_file) ? File.read(stamp_file) : nil

  if File.executable?(dmgbuild) && InvoicesTracker::DmgTool.up_to_date?(stamp, requirements)
    UI.message("dmgbuild is installed in #{venv_dir}")
    return dmgbuild
  end

  UI.message("Installing dmgbuild into #{venv_dir} (the first run, or the requirements changed)...")
  FileUtils.rm_rf(venv_dir)
  setup = InvoicesTracker::DmgTool.setup_commands(python: "python3", venv_dir: venv_dir, requirements: DMG_REQUIREMENTS)
  setup.each { |argv| run_argv(argv) }
  File.write(stamp_file, InvoicesTracker::DmgTool.requirements_digest(requirements))
  dmgbuild
end

# --- the developer portal ----------------------------------------------------

# Registers the macOS App ID on the team when it is not registered yet.
def ensure_app_id(api_key)
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

  bundle_id = InvoicesTracker::Release::BUNDLE_ID
  if Spaceship::ConnectAPI::BundleId.find(bundle_id)
    UI.message("App ID #{bundle_id} is registered")
    return
  end

  Spaceship::ConnectAPI::BundleId.create(
    name: InvoicesTracker::Release::APP_NAME,
    platform: Spaceship::ConnectAPI::BundleIdPlatform::MAC_OS,
    identifier: bundle_id
  )
  UI.success("Registered the App ID #{bundle_id}")
end

# Fetches the Developer ID profile and installs it where Xcode looks for
# profiles; `output_path` gets a copy.
#
# The read-only pass reuses the profile without changing the portal. It
# succeeds only when the profile is active, unexpired and made for a
# certificate in the local keychain, which is what the export needs. The name
# must match exactly, so a "<name> <timestamp>" duplicate is never adopted.
#
# Only when reuse fails is the profile renewed. It is first deleted by its
# exact name through the API: sigh's own renewal deletes only profiles it could
# fetch, and it never fetches one whose certificate is missing from the
# keychain, so it would add a "<name> <timestamp>" duplicate on every run
# instead. fail_on_name_taken turns any name collision that is left into an
# error rather than another duplicate.
def ensure_profile(api_key, output_path:)
  name = InvoicesTracker::Release::PROFILE_NAME
  options = {
    api_key: api_key,
    app_identifier: InvoicesTracker::Release::BUNDLE_ID,
    provisioning_name: name,
    platform: "macos",
    developer_id: true,
    ignore_profiles_with_different_name: true,
    # sigh's default, ".", is the repository root.
    output_path: output_path
  }

  begin
    get_provisioning_profile(**options, readonly: true)
    UI.success("Reusing profile '#{name}'")
  rescue FastlaneCore::Interface::FastlaneError => e
    UI.important("Cannot reuse profile '#{name}' (#{e.message.strip}) — renewing it")
    # The name filter of the API also matches longer names; only the exact name goes.
    stale = Spaceship::ConnectAPI::Profile.all(filter: { name: name }).select { |profile| profile.name == name }
    stale.each(&:delete!)
    UI.message("Deleted #{stale.size} profile(s) named '#{name}'")
    get_provisioning_profile(**options, fail_on_name_taken: true)
  end

  # sigh records the profiles it fetched in the lane context, and build_app
  # merges them into its export options. The export options name the profile
  # explicitly, and nothing may override them.
  lane_context.delete(SharedValues::SIGH_PROFILE_PATHS)
  lane_context.delete(SharedValues::SIGH_PROFILE_PATH)
  lane_context.delete(SharedValues::SIGH_PROFILE_TYPE)
end

# --- the build ---------------------------------------------------------------

# The xcargs of the local archive. It keeps the project's automatic signing:
# signing settings forced on the command line would reach the SQLCipher package
# target too, which takes no profile. -allowProvisioningUpdates, authenticated
# with the API key, lets xcodebuild reach the portal without the accounts in
# Xcode's settings. xcargs is split like a shell command line, so every value
# is escaped.
def local_archive_xcargs(key_settings)
  Shellwords.join([
    "-skipMacroValidation",
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", key_settings.key_file,
    "-authenticationKeyID", key_settings.key_id,
    "-authenticationKeyIssuerID", key_settings.issuer_id
  ])
end

# Archives the app with `xcargs` (one string, split like a shell command line)
# and exports it for Developer ID distribution. The export signs manually: the
# team, the certificate by its SHA-1 (another team's Developer ID is in the
# keychain too) and the profile by its name.
def archive_and_export(paths:, identity:, xcargs:)
  with_system_rsync_first do
    build_app(
      project: paths[:project],
      scheme: InvoicesTracker::Release::SCHEME,
      configuration: CONFIGURATION,
      export_method: "developer-id",
      destination: "generic/platform=macOS",
      archive_path: paths[:archive],
      output_directory: paths[:export_dir],
      output_name: InvoicesTracker::Release::APP_NAME,
      clean: true,
      derived_data_path: paths[:derived_data],
      xcodebuild_formatter: XCODEBUILD_FORMATTER,
      xcargs: xcargs,
      export_options: {
        signingStyle: "manual",
        teamID: InvoicesTracker::Release::TEAM_ID,
        signingCertificate: identity.sha1,
        provisioningProfiles: { InvoicesTracker::Release::BUNDLE_ID => InvoicesTracker::Release::PROFILE_NAME }
      }
    )
  end

  UI.user_error!("The export did not produce #{paths[:app]}") unless File.directory?(paths[:app])
end

# Runs a block with Apple's /usr/bin first in PATH, then restores PATH. The
# export copies the app with `/usr/bin/rsync -8aPhhE`, where -E means extended
# attributes. rsync forks a helper that it finds through PATH, and a Homebrew
# rsync 3.x earlier in PATH reads -E as --executability and rejects the
# arguments, so the export fails with "rsync error: syntax or usage error".
# With /usr/bin first, both ends are Apple's rsync. Only the child processes
# started inside the block see the changed PATH.
def with_system_rsync_first
  previous_path = ENV["PATH"]
  ENV["PATH"] = "/usr/bin:#{previous_path}"
  yield
ensure
  ENV["PATH"] = previous_path
end

# The icon for the disk image volume: the app's AppIcon.icns, else the first
# .icns among its resources, or nil when it has none.
def volume_icon(app)
  resources = File.join(app, "Contents", "Resources")
  icons = Dir.glob("*.icns", base: resources).sort
  icon = icons.include?("AppIcon.icns") ? "AppIcon.icns" : icons.first
  icon && File.join(resources, icon)
end

# Deletes the DMG that an earlier run left at `path`. One that cannot be deleted
# stops the lane: it would stay at the final path, looking like this run's result.
def remove_previous_dmg(path)
  FileUtils.rm_f(path)
  UI.user_error!("Cannot delete the previous DMG at #{path}; delete it and run the lane again") if File.exist?(path)
end

# Runs the steps that make the DMG at `path`. If one of them fails, or the run
# is interrupted, the DMG is deleted before the error goes on, so a DMG that was
# not verified is never left behind looking finished. Exception rather than
# StandardError, so an interrupt cleans up as well; it is raised again as is.
def deleting_on_failure(path)
  yield
rescue Exception
  FileUtils.rm_f(path)
  raise
end

# --- CI: the run and the temporary keychain ----------------------------------

# The options of a CI run, once the lane knows it may run here. It refuses to
# run outside a CI runner, without RUNNER_TEMP, or with a deploy or skip_tests
# that is neither true nor false, giving every reason at once. Returns the
# typed version and build, trimmed, the two flags and the runner's temporary
# folder.
def ci_options(options)
  errors = InvoicesTracker::CiBuild.environment_errors(ENV)
  flags = {}
  %i[deploy skip_tests].each do |name|
    flags[name] = InvoicesTracker::CiBuild.flag(options[name], name: name)
  rescue ArgumentError => e
    errors << e.message
  end
  UI.user_error!("ci_dmg cannot run here:\n#{bullet_list(errors)}") unless errors.empty?

  runner_temp = File.expand_path(ENV.fetch("RUNNER_TEMP"))
  unless File.directory?(runner_temp)
    UI.user_error!("RUNNER_TEMP is not a folder: #{InvoicesTracker::LogText.line(runner_temp)}")
  end

  { version: options[:version].to_s.strip, build: options[:build].to_s.strip, deploy: flags[:deploy],
    skip_tests: flags[:skip_tests], runner_temp: runner_temp }
end

# The keychains in the user's search list now, as `security list-keychains -d
# user` prints them: the temporary keychain goes in front of them, and the list
# is put back afterwards. An empty list stops the lane before anything is
# changed, since putting back nothing would leave the user without a keychain.
def keychain_search_list
  list = InvoicesTracker::CiKeychain.parse_search_list(run_argv(["security", "list-keychains", "-d", "user"]))
  UI.user_error!("security list-keychains -d user lists no keychain — the search list is left alone") if list.empty?
  list
end

# The Developer ID identity of DEVELOPER_ID_P12, a .p12 file in base64, opened
# with DEVELOPER_ID_P12_PASSWORD and encrypted again in memory under a random
# throwaway password: { der:, password: }. `security import` takes the password
# of the file it imports as an argument, so only the throwaway one may reach a
# command line. Both secrets are taken out of the environment here, and neither
# is written or printed.
def rewrapped_developer_id
  encoded = ENV.delete("DEVELOPER_ID_P12").to_s
  secret_password = ENV.delete("DEVELOPER_ID_P12_PASSWORD").to_s
  UI.user_error!("DEVELOPER_ID_P12 is not set") if encoded.strip.empty?

  password = SecureRandom.hex(32)
  der = InvoicesTracker::CiKeychain.rewrap_p12(encoded.unpack1("m"), password: secret_password, new_password: password)
  { der: der, password: password }
rescue ArgumentError => e
  # No message of rewrap_p12 quotes a password.
  UI.user_error!(e.message)
end

# Makes the temporary keychain at `keychain` with a random password, imports
# the identity into it for codesign, and puts it in front of `search_list` in
# the user's search list. The re-encrypted identity is written for `security
# import` alone, into a folder of its own under `runner_temp` that only this
# user can open, readable by this user only, and the folder is deleted with it
# as soon as the import has run, whether or not it worked.
def make_signing_keychain(keychain:, search_list:, identity_file:, runner_temp:)
  UI.message("Making the temporary keychain #{keychain}...")
  after_import = Dir.mktmpdir("invoices-p12-", runner_temp) do |folder|
    p12_path = File.join(folder, "developer-id.p12")
    File.open(p12_path, File::WRONLY | File::CREAT | File::EXCL | File::BINARY, 0o600) do |file|
      file.write(identity_file[:der])
    end
    commands = InvoicesTracker::CiKeychain.setup_commands(
      keychain: keychain, keychain_password: SecureRandom.hex(32), p12_path: p12_path,
      p12_password: identity_file[:password], search_list: search_list
    )
    import = commands.index { |command| command[1] == "import" } || raise("the keychain setup imports nothing")
    commands.first(import + 1).each { |command| run_argv(command) }
    commands.drop(import + 1)
  end
  after_import.each { |command| run_argv(command) }
  UI.success("The Developer ID identity is in the temporary keychain")
end

# Undoes make_signing_keychain: puts the user's search list back to
# `search_list` and deletes the keychain with the identity in it. It runs
# however the build ended, so a command that fails is reported and the next
# one still runs; the workflow's last step deletes a keychain left behind.
def remove_signing_keychain(keychain:, search_list:)
  failed = false
  InvoicesTracker::CiKeychain.teardown_commands(keychain: keychain, search_list: search_list).each do |command|
    run_argv(command)
  rescue FastlaneCore::Interface::FastlaneError => e
    failed = true
    UI.important("Could not undo the temporary keychain: #{e.message}")
  end
  UI.message("Removed the temporary keychain and put the search list back") unless failed
end

# --- CI: the build -----------------------------------------------------------

# Everything ci_dmg does once the temporary keychain holds the identity: the
# steps of the dmg lane, with the CI lane's own checks in the preflight, the
# tests signed ad hoc and without the timing suites, and the archive signed
# with the Developer ID identity from `keychain`. `sparkle_key` is the
# SPARKLE_PRIVATE_KEY secret, which only a deploy's preflight uses.
def build_on_ci(ci, keychain:, sparkle_key:)
  tools = REQUIRED_TOOLS + (ci[:deploy] ? ["gh"] : [])
  checked = preflight(tools: tools) do |versions:, missing_tools:, info_plist_file:|
    ci_preflight_errors(ci, versions: versions, gh_installed: !missing_tools.include?("gh"),
                            info_plist_file: info_plist_file, sparkle_key: sparkle_key)
  end
  versions, identity, key_settings, working_copy =
    checked.values_at(:versions, :identity, :key_settings, :working_copy)
  paths = announce_build(versions: versions, identity: identity, working_copy: working_copy)
  UI.message("Deploy:   #{ci[:deploy] ? 'yes, sparkle_feed makes the feed next' : 'no'}")

  dmgbuild = ensure_dmgbuild
  clear_previous_build(paths)

  if ci[:skip_tests]
    UI.important("Skipping the unit tests (skip_tests:true)")
  else
    UI.message("Leaving out the timing suites: #{InvoicesTracker::CiBuild::SKIPPED_TEST_SUITES.join(', ')}")
    unit_tests(paths, xcargs: Shellwords.join(InvoicesTracker::CiBuild.test_xcargs),
                      skip_testing: InvoicesTracker::CiBuild.skip_testing)
  end

  api_key = register_app_and_profile(key_settings, paths)
  with_manual_app_signing(paths[:project], identity) do
    archive_and_export(paths: paths, identity: identity,
                       xcargs: Shellwords.join(InvoicesTracker::CiBuild.archive_xcargs(keychain: keychain)))
  end

  # As in the dmg lane, once the project file is back as it was.
  ensure_working_copy_unchanged(since: working_copy)

  notarized_dmg(paths: paths, identity: identity, api_key: api_key, dmgbuild: dmgbuild)
  UI.success("DMG ready: #{paths[:final_dmg]} (#{working_copy.short_head})")
end

# The CI lane's own problems, which follow those of the dmg lane. The typed
# numbers must be the branch's; when the branch's could not be read, only their
# format is checked. A deploy must also have what a release needs, with the
# app's update settings read from the file INFOPLIST_FILE names, relative to
# the repository root.
def ci_preflight_errors(ci, versions:, gh_installed:, info_plist_file:, sparkle_key:)
  version = ci[:version]
  build = ci[:build]
  errors = if versions
             InvoicesTracker::BuildSettings.mismatch_errors(versions, version: version, build: build)
           else
             InvoicesTracker::BuildSettings.typed_format_errors(version: version, build: build)
           end
  return errors unless ci[:deploy]

  info_plist = read_plist(info_plist_file && File.expand_path(info_plist_file, REPO_ROOT))
  errors + deploy_check(version: version, build: build, gh_installed: gh_installed, info_plist: info_plist,
                        sparkle_key: sparkle_key)[:errors]
end

# What decides whether `version` and `build`, trimmed, may be released, as
# DeployPreflight judges it: the changelog in RELEASE_CHANGELOG, whether the tag
# is new, the Latest release, the app's update settings in `info_plist` (a
# Hash, nil when it could not be read) and `sparkle_key`, the private key (nil
# when SPARKLE_PRIVATE_KEY is not set). Returns a Hash: `latest_release`, nil
# when nothing is published or GitHub could not tell, and `errors`, those of
# asking GitHub first. The facts hold the key, so they are never printed whole.
def deploy_check(version:, build:, gh_installed:, info_plist:, sparkle_key:)
  github = github_facts(version: version, build: build, gh_installed: gh_installed)
  facts = InvoicesTracker::DeployPreflight::Facts.new(
    version: version, build: build, changelog: ENV["RELEASE_CHANGELOG"], tag_exists: github[:tag_exists],
    latest_release: github[:latest_release], info_plist: info_plist, sparkle_private_key: sparkle_key
  )
  { latest_release: github[:latest_release], errors: github[:errors] + InvoicesTracker::DeployPreflight.errors(facts) }
end

# What GitHub says about the release of `version` and `build`: whether its tag
# exists, and the Latest release. Without gh nothing is asked; the preflight
# reports gh as missing. The tag goes into the address of a question, so it is
# asked about only when both numbers are well formed; when they are not, that
# is reported already. A question that fails is a problem of its own.
def github_facts(version:, build:, gh_installed:)
  facts = { tag_exists: false, latest_release: nil, errors: [] }
  return facts unless gh_installed

  repository = InvoicesTracker::Release::REPOSITORY
  if InvoicesTracker::BuildSettings.typed_format_errors(version: version, build: build).empty?
    tag = InvoicesTracker::ReleaseNaming.tag(version: version, build: build)
    facts[:tag_exists] = asking_github(facts[:errors]) do
      InvoicesTracker::GitHubReleases.tag_exists?(repository: repository, tag: tag, gh: gh_cli)
    end || false
  end
  facts[:latest_release] = asking_github(facts[:errors]) do
    InvoicesTracker::GitHubReleases.latest(repository: repository, gh: gh_cli)
  end
  facts
end

# The answer of a question to GitHub. One that fails adds a problem to
# `errors` and gives nil; the message names the call and quotes nothing of what
# gh printed.
def asking_github(errors)
  yield
rescue RuntimeError, SystemCallError => e
  errors << "GitHub could not be asked — #{e.message}; gh signs in with GH_TOKEN"
  nil
end

# The gh command-line tool as GitHubReleases calls it: the arguments of one
# call in, [stdout, stderr, success] out. gh signs in with GH_TOKEN from the
# environment, so the token never passes through here.
def gh_cli
  lambda do |args|
    stdout, stderr, status = Open3.capture3("gh", *args)
    [stdout, stderr, status.success?]
  end
end

# Runs the block with only the app target's Release configuration switched to
# manual signing in the project file: the team, the Developer ID identity by
# its SHA-1 and the profile by its name. The runner has no Apple Development
# certificate, and automatic signing would register the runner as a device;
# the SQLCipher package target keeps its settings. The project file gets its
# bytes and its permissions back when the block ends, after a failure too, so
# the working copy is what it was when it is checked again.
def with_manual_app_signing(project, identity)
  pbxproj = File.join(project, "project.pbxproj")
  original = File.binread(pbxproj)
  mode = File.stat(pbxproj).mode & 0o7777
  begin
    update_code_signing_settings(
      path: project,
      use_automatic_signing: false,
      targets: [APP_TARGET],
      build_configurations: [CONFIGURATION],
      team_id: InvoicesTracker::Release::TEAM_ID,
      code_sign_identity: identity.sha1,
      profile_name: InvoicesTracker::Release::PROFILE_NAME
    )
    yield
  ensure
    File.binwrite(pbxproj, original)
    File.chmod(mode, pbxproj)
  end
end

# --- the Sparkle feed --------------------------------------------------------

# The Info.plist of the app inside the DMG at `dmg`, as a Hash, nil when it
# cannot be read. The image is attached read-only, out of Finder's sight, at a
# folder of its own, and detached again.
def info_plist_in_dmg(dmg)
  mount_point = Dir.mktmpdir("invoices-feed-")
  run_argv(["hdiutil", "attach", dmg, "-readonly", "-nobrowse", "-noautoopen", "-mountpoint", mount_point])
  begin
    read_plist(File.join(mount_point, "#{InvoicesTracker::Release::APP_NAME}.app", "Contents", "Info.plist"))
  ensure
    detach_image(mount_point)
  end
ensure
  remove_empty_folder(mount_point)
end

# Detaches the disk image attached at `mount_point`, with -force if the first
# attempt fails, since macOS may still hold the volume for a moment. An image
# that stays attached is reported, not an error: it is attached read-only.
def detach_image(mount_point)
  [[], ["-force"]].each do |force|
    _output, status = Open3.capture2e("hdiutil", "detach", mount_point, *force)
    return if status.success?
  end
  UI.important("Could not detach the disk image at #{mount_point}")
end

# Removes the folder at `path` if it is empty. One that is not, such as a
# mount point whose image is still attached, stays as it is.
def remove_empty_folder(path)
  Dir.rmdir(path) if path && File.directory?(path)
rescue SystemCallError
  nil
end

# Makes and checks the appcast of the DMG with Sparkle's generate_appcast,
# signed with `sparkle_key`, and returns its path. generate_appcast reads every
# archive in the folder it is given, so it gets a fresh staging folder with a
# copy of the DMG and `notes` beside it, named like the DMG with .md, which it
# embeds. The key reaches it on standard input only, never on a command line,
# in its environment or in a file. Stops when generate_appcast fails or the
# appcast must not be published.
def signed_appcast(dmg:, notes:, tools_dir:, version:, build:, sparkle_key:)
  FileUtils.rm_rf(FEED_STAGING_DIR)
  FileUtils.mkdir_p(FEED_STAGING_DIR)
  dmg_name = File.basename(dmg)
  FileUtils.cp(dmg, File.join(FEED_STAGING_DIR, dmg_name))
  File.binwrite(File.join(FEED_STAGING_DIR, InvoicesTracker::ReleaseNaming.notes_filename(dmg_name)), notes)

  appcast = File.join(FEED_STAGING_DIR, InvoicesTracker::GitHubReleases::APPCAST_NAME)
  prefix = InvoicesTracker::ReleaseNaming.download_prefix(version: version, build: build)
  argv = InvoicesTracker::Sparkle.generate_appcast_command(
    tools_dir: tools_dir, archives_dir: FEED_STAGING_DIR, download_url_prefix: prefix,
    link: InvoicesTracker::Release::RELEASES_URL, output: appcast
  )
  key = sparkle_key.to_s.strip
  UI.message("Making the appcast with generate_appcast...")
  # The staging folder is the working directory, so no file named "-" there can stand in for standard input.
  stdout, stderr, status = Open3.capture3(*argv, stdin_data: key, chdir: FEED_STAGING_DIR)
  output = without_secret("#{stdout}#{stderr}", key).lines.map(&:strip).reject(&:empty?)
  UI.user_error!("generate_appcast failed (exit #{status.exitstatus}):\n#{bullet_list(output)}") unless status.success?
  # Each line after a word of the lane's own, so that none can start a workflow command.
  output.each { |line| UI.message("generate_appcast: #{InvoicesTracker::LogText.line(line)}") }
  UI.user_error!("generate_appcast wrote no appcast at #{appcast}") unless File.file?(appcast)

  problems = InvoicesTracker::Sparkle.feed_problems(
    File.read(appcast), archive_url: "#{prefix}#{dmg_name}", version: version, build: build
  )
  UI.user_error!("The appcast must not be published:\n#{bullet_list(problems)}") unless problems.empty?
  appcast
end

# Writes the feed folder for the publish job: the DMG, the appcast, the notes
# and release.json, which names them, gives their SHA-256, and records the
# commit the release is built from and the Latest release seen (`latest`, nil
# when nothing is published). Returns the contents of release.json.
def write_feed(dmg:, appcast:, notes:, version:, build:, latest:)
  FileUtils.rm_rf(FEED_DIR)
  FileUtils.mkdir_p(FEED_DIR)
  dmg_copy = File.join(FEED_DIR, File.basename(dmg))
  appcast_copy = File.join(FEED_DIR, InvoicesTracker::GitHubReleases::APPCAST_NAME)
  FileUtils.cp(dmg, dmg_copy)
  FileUtils.cp(appcast, appcast_copy)
  File.binwrite(File.join(FEED_DIR, InvoicesTracker::ReleaseManifest::NOTES_FILE_NAME), notes)

  manifest = InvoicesTracker::ReleaseManifest.contents(
    version: version, build: build, commit: working_copy_snapshot.head, dmg: File.basename(dmg),
    dmg_sha256: Digest::SHA256.file(dmg_copy).hexdigest, appcast_sha256: Digest::SHA256.file(appcast_copy).hexdigest,
    latest_tag: latest&.tag
  )
  File.write(File.join(FEED_DIR, InvoicesTracker::ReleaseManifest::FILE_NAME),
             InvoicesTracker::ReleaseManifest.json(manifest))
  manifest
end

# `text`, the output of a tool that was given `secret`, with every occurrence
# of the secret replaced, so that printing it cannot show the secret. The text
# is read as UTF-8, with bytes that are not replaced.
def without_secret(text, secret)
  text = text.dup.force_encoding(Encoding::UTF_8).scrub
  secret.empty? ? text : text.gsub(secret, "[secret]")
end

# --- verification ------------------------------------------------------------

# What Gatekeeper, the stapler and codesign say about the DMG and the app, as a
# list of problems that is empty when all is well.
def verification_errors(dmg:, app:)
  team_id = InvoicesTracker::Release::TEAM_ID
  spctl = combined_output("spctl", "--assess", "--type", "open", "--context", "context:primary-signature", "-vvv", dmg)
  errors = InvoicesTracker::Verification.gatekeeper_errors(spctl, path: dmg)
  [dmg, app].each do |path|
    errors += InvoicesTracker::Verification.staple_errors(
      combined_output("xcrun", "stapler", "validate", path), path: path
    )
  end
  [dmg, app].each do |path|
    errors += InvoicesTracker::Verification.team_errors(
      combined_output("codesign", "-dv", "--verbose=2", path), path: path, team_id: team_id
    )
  end
  errors
end

# What a command printed, stdout and stderr together: spctl and codesign give
# their verdicts on stderr, the stapler on stdout. The exit status is not used;
# Verification reads the verdict from the text.
def combined_output(*argv)
  output, _status = Open3.capture2e(*argv)
  output
end

# --- helpers -----------------------------------------------------------------

# Runs a shell command without turning it into a fastlane step, and returns its
# stdout. With must_succeed: true, a non-zero exit stops the lane with the
# command's stderr.
def run(command, must_succeed:)
  stdout, stderr, status = Open3.capture3("/bin/sh", "-c", command)
  if must_succeed && !status.success?
    UI.user_error!("Command failed (exit #{status.exitstatus}): #{command}\n#{stderr.strip}")
  end
  stdout
end

# Runs an argument list without a shell and returns its stdout. A non-zero exit
# stops the lane with the tool's stderr, or its stdout when stderr is empty,
# once `retries` more attempts have failed as well. The block, if one is given,
# runs before each retry to clear away what the failed attempt left.
def run_argv(argv, retries: 0, &before_retry)
  attempts = 0
  begin
    attempts += 1
    stdout, stderr, status = Open3.capture3(*argv)
    unless status.success?
      raise "#{argv.first} failed (exit #{status.exitstatus}): #{stderr.strip.empty? ? stdout.strip : stderr.strip}"
    end

    stdout
  rescue RuntimeError, SystemCallError => e
    if attempts <= retries
      UI.important("#{e.message} — trying again")
      before_retry&.call
      retry
    end
    UI.user_error!(e.message)
  end
end

# The line of a tool's output that says what went wrong: the first one with
# "error:" in it, else the last one.
def error_line(output)
  lines = output.lines.map(&:strip).reject(&:empty?)
  lines.find { |line| line.include?("error:") } || lines.last || "no output"
end

# The items as an indented list, one line each. Every item goes through
# LogText.line: a typed value in a message cannot break its line, so no line of
# the list can start a workflow command on a CI runner.
def bullet_list(items)
  items.map { |item| "  - #{InvoicesTracker::LogText.line(item)}" }.join("\n")
end
